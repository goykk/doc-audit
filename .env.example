# Copy to .env and fill locally. .env is gitignored.

# --- LLM / VLM (DashScope OpenAI-compatible endpoint) ---
DASHSCOPE_API_KEY=sk-your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Header + line_items structured extraction (route A)
LLM_MODEL=qwen-plus
# End-to-end image extraction (route B). This account has qwen3-vl-plus / qwen-vl-ocr.
VLM_MODEL=qwen3-vl-plus
VLM_MAX_IMAGE_SIDE=1600
VLM_INPUT_PRICE_PER_1K=0.0012
VLM_OUTPUT_PRICE_PER_1K=0.012
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120
# Reference qwen-plus list price (CNY / 1K tokens); adjust to your account tier.
LLM_INPUT_PRICE_PER_1K=0.0008
LLM_OUTPUT_PRICE_PER_1K=0.002

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=docaudit
MYSQL_USER=docaudit
MYSQL_PASSWORD=docaudit_pwd
MYSQL_ROOT_PASSWORD=root_pwd

# --- API auth (optional locally; enable in production) ---
AUTH_REQUIRED=false
# JSON map token -> role. Roles: viewer (GET), reviewer (writes), admin.
# API_KEYS={"change-me-viewer":"viewer","change-me-reviewer":"reviewer"}

# --- Pipeline ---
# 200 dpi is the default render resolution; quality tier is logged per document.
PDF_RENDER_DPI=200
# accepted requires all rules passed AND min(field confidence) >= threshold
AUTO_ACCEPT_CONFIDENCE=0.85
# cosine similarity above this value on line-item embeddings -> duplicate_invoice
DUPLICATE_VECTOR_THRESHOLD=0.92

# --- MinerU (runs in its own Python 3.11/3.12 venv, GPU pipeline backend) ---
MINERU_BACKEND=pipeline
MINERU_DEVICE=cuda
MINERU_OUTPUT_DIR=data/processed/mineru
# Optional override; defaults to .venv-mineru/Scripts/mineru.exe
MINERU_EXECUTABLE=
